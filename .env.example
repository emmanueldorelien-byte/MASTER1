# ============================================================
#  MASTERCLASS AI — Variables necesarias en VERCEL
#
#  ⚠️  OBLIGATORIO: configura ESTAS 6 variables antes de desplegar.
#  Si faltan, las funciones Nitro crashearan con error 500.
#
#  Pasos:
#   1. Entra a: Vercel Dashboard → Tu Proyecto → Settings →
#      Environment Variables
#   2. Crea cada variable marcada ✅
#   3. Tilda Environment: Production + Preview + Development
#   4. Redeploya el proyecto (Deployments → ︙ → Redeploy)
# ============================================================

# ✅ OBLIGATORIAS — Supabase (SERVIDOR — SECRETAS)
# NO son públicas. NUNCA las pongas en VITE_*.
# Consíguelas en: https://supabase.com/dashboard/project/<TU_ID>/settings/api
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXX (service_role, TEN CUIDADO!)

# ✅ OBLIGATORIAS — Supabase (CLIENTE — expuestas al navegador)
# DEBEN TENER LOS MISMOS VALORES que SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 📧 SMTP — Confirmación por email (OPCIONALES)
# Si se dejan vacías, la inscripción sigue funcionando pero NO se envía email.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Masterclass AI <onboarding@resend.dev>"
SMTP_REPLY_TO=tu@dominio.com
