# ============================================================
#  MASTERCLASS AI — Variables necesarias en VERCEL
#  Cómo usarlas:
#   1. Entra a: Vercel Dashboard → Tu Proyecto → Settings →
#      Environment Variables
#   2. Crea cada variable (tildar Environment: Production +
#      Preview + Development)
#   3. Redeploya el proyecto (o haz un nuevo push)
# ============================================================

# 🔑 SUPABASE (OBLIGATORIAS — servidor)
# NO son públicas. NUNCA las pongas en VITE_*.
# Consíguelas en: https://supabase.com/dashboard/project/<TU_ID>/settings/api
SUPABASE_PROJECT_ID=tu-project-id-aqui
SUPABASE_URL=https://tu-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...... (clave anon/publishable)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_.............. (clave service_role — SECRETO)

# 🌐 SUPABASE (CLIENTE — OBLIGATORIAS — exponidas al navegador)
# Deben tener LOS MISMOS VALORES que arriba.
VITE_SUPABASE_PROJECT_ID=tu-project-id-aqui
VITE_SUPABASE_URL=https://tu-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...... (misma que SUPABASE_PUBLISHABLE_KEY)

# 📧 SMTP — Confirmación por email (OPCIONALES)
# Si se dejan vacías, la inscripción sigue funcionando pero NO se envía email.
# Proveedores recomendados: Resend, Brevo (Sendinblue), Gmail (app password), AWS SES, Mailgun.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Masterclass AI <onboarding@resend.dev>"
SMTP_REPLY_TO=tu@dominio.com
