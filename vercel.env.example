# Ejemplo de variables para Vercel (NO subir secretos)
# Copia el contenido en Vercel Dashboard → Project → Settings → Environment Variables

SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_PUBLISHABLE_KEY=public_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=public_XXXXXXXXXXXXXXXXXXXXXXXX

# Opcionales (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario
SMTP_PASS=contraseña
SMTP_FROM="Masterclass AI <onboarding@example.com>"
SMTP_REPLY_TO=tu@dominio.com
